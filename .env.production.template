# ==============================================================================
# AI STOCK ANALYTICS - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and populate all values before running ./deploy.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# MARKET DATA PROVIDER (Required)
# ------------------------------------------------------------------------------
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Alpha Vantage provides real-time and historical stock data
MARKET_API_KEY=your_alpha_vantage_api_key_here

# ------------------------------------------------------------------------------
# AI / LLM PROVIDERS (Required for Multi-Agent Swarm)
# ------------------------------------------------------------------------------
# OpenRouter - Unified API for open-source models (Llama 3, Mixtral, etc.)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model Configuration for Multi-Agent Swarm
LLM_BULL_MODEL=meta-llama/llama-3-70b-instruct
LLM_BEAR_MODEL=meta-llama/llama-3-70b-instruct
LLM_CONSENSUS_MODEL=anthropic/claude-3.5-sonnet
USE_SWARM=true

# Anthropic - Required for Consensus Agent (Claude 3.5 Sonnet)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# DATABASE - SUPABASE (Required)
# ------------------------------------------------------------------------------
# Create a project at: https://supabase.com/
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Project Settings > API > anon public key (for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Project Settings > API > service_role key (for backend - KEEP SECRET!)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Project Settings > API > JWT Secret (for backend token verification)
# This is CRITICAL for authentication - copy exactly as shown
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ------------------------------------------------------------------------------
# INFRASTRUCTURE (Required)
# ------------------------------------------------------------------------------
# Redis - Uses dockerized Redis container by default
# No changes needed unless using external Redis (e.g., AWS ElastiCache)
REDIS_URL=redis://redis:6379

# Backend API Port
PORT=8000

# Frontend API URL (for Next.js to call FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# WEBHOOK NOTIFICATIONS (Optional - For Scanner Alerts)
# ------------------------------------------------------------------------------
# Discord - Create webhook in Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Slack - Create Incoming Webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Telegram - Create bot via @BotFather, get token and chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# CELERY CONFIGURATION (Auto-configured via docker-compose)
# ------------------------------------------------------------------------------
# These are set automatically in docker-compose.yml
# CELERY_BROKER_URL=redis://redis:6379
# CELERY_RESULT_BACKEND=redis://redis:6379

# ==============================================================================
# END OF TEMPLATE - DO NOT EDIT BELOW THIS LINE UNLESS YOU KNOW WHAT YOU'RE DOING
# ==============================================================================